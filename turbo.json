{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "ENABLE_EXPERIMENTAL_COREPACK",
    "BLOCKSCOUT_PRO_API_KEY",
    "BLOCKSCOUT_DEFAULT_CHAIN_IDS",
    "BLOCKSCOUT_MAX_CHAINS_PER_REQUEST",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!docs/**"],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
