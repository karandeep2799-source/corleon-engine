DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Razorpay API credentials (server-only; never expose the secret to the browser)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Explicitly remain disabled until verified server-side auth and test-mode validation pass
PAYMENTS_ENABLED="false"
RAZORPAY_CHECKOUT_ENABLED="false"

# Google Pay & Wallet Developer MCP is configured separately in ChatGPT using OAuth.
# For India, Google Pay appears as a UPI option in Razorpay Standard Checkout when enabled for the merchant.
