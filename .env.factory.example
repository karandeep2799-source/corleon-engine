# Corleon Forge — configuration contract only.
# Copy values into your deployment provider's encrypted environment settings.
# Do not commit real credentials. These variables are not wired into runtime yet.

CORLEON_FORGE_ENABLED=false
CORLEON_FORGE_REPOSITORY=karandeep2799-source/corleon-engine
CORLEON_FORGE_INTAKE_LABEL=corleon-forge
CORLEON_FORGE_BRANCH_PREFIX=corleon-forge/
CORLEON_FORGE_MAX_ATTEMPTS=2
CORLEON_FORGE_RUN_TIMEOUT_SECONDS=1800
CORLEON_FORGE_MAX_CONCURRENT_RUNS=1
CORLEON_FORGE_REQUIRE_HUMAN_MERGE=true
CORLEON_FORGE_REQUIRE_HUMAN_DEPLOY=true

# Configure only after selecting and implementing the relevant adapters:
# CORLEON_FORGE_GITHUB_APP_ID=
# CORLEON_FORGE_GITHUB_PRIVATE_KEY=   # store in a secret manager, never in git
# CORLEON_FORGE_GITHUB_WEBHOOK_SECRET=
# CORLEON_FORGE_SANDBOX_PROVIDER=vercel
# CORLEON_FORGE_AI_GATEWAY_API_KEY=
# CORLEON_FORGE_DATABASE_URL=         # reuse the project's approved DATABASE_URL strategy
