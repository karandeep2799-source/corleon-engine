generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum CreativeProjectStatus { ACTIVE ARCHIVED }
enum CreativeJobStatus { QUEUED RUNNING SUCCEEDED FAILED CANCELLED }
enum CreativeJobMode { GENERATE EDIT }
enum CreativeProvider { OPENAI }
enum CreativeAssetStatus { READY DELETED }
enum CreativeAgentStatus { QUEUED RUNNING SUCCEEDED FAILED }
model CreativeTenant { id String @id @default(cuid()) name String slug String @unique createdAt DateTime @default(now()) updatedAt DateTime @updatedAt apiKeys CreativeApiKey[] projects CreativeProject[] jobs GenerationJob[] assets GeneratedAsset[] references ImageReference[] templates PromptTemplate[] executions AgentExecution[] usage GenerationUsage[] auditEvents AuditEvent[] }
model CreativeApiKey { id String @id @default(cuid()) tenantId String name String keyPrefix String keyHash String @unique createdAt DateTime @default(now()) lastUsedAt DateTime? expiresAt DateTime? revokedAt DateTime? tenant CreativeTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) @@index([tenantId,revokedAt]) }
model CreativeProject { id String @id @default(cuid()) tenantId String name String slug String description String? status CreativeProjectStatus @default(ACTIVE) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt tenant CreativeTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) jobs GenerationJob[] assets GeneratedAsset[] references ImageReference[] templates PromptTemplate[] executions AgentExecution[] @@unique([tenantId,slug]) @@index([tenantId,status,updatedAt]) }
model GenerationJob { id String @id @default(cuid()) tenantId String projectId String idempotencyKey String mode CreativeJobMode @default(GENERATE) status CreativeJobStatus @default(QUEUED) provider CreativeProvider @default(OPENAI) model String prompt String @db.Text enhancedPrompt String? @db.Text referenceId String? size String @default("1024x1024") quality String @default("high") outputFormat String @default("webp") errorCode String? errorMessage String? @db.Text attemptCount Int @default(0) createdAt DateTime @default(now()) startedAt DateTime? completedAt DateTime? updatedAt DateTime @updatedAt tenant CreativeTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) project CreativeProject @relation(fields:[projectId],references:[id],onDelete:Cascade) reference ImageReference? @relation(fields:[referenceId],references:[id],onDelete:SetNull) assets GeneratedAsset[] executions AgentExecution[] usage GenerationUsage? @@unique([tenantId,idempotencyKey]) @@index([tenantId,status,createdAt]) @@index([projectId,createdAt]) }
model GeneratedAsset { id String @id @default(cuid()) tenantId String projectId String generationJobId String? status CreativeAssetStatus @default(READY) storageKey String @unique mimeType String format String width Int? height Int? byteSize BigInt sha256 String prompt String @db.Text createdAt DateTime @default(now()) deletedAt DateTime? tenant CreativeTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) project CreativeProject @relation(fields:[projectId],references:[id],onDelete:Cascade) generationJob GenerationJob? @relation(fields:[generationJobId],references:[id],onDelete:SetNull) versions AssetVersion[] @@index([tenantId,projectId,createdAt]) }
model AssetVersion { id String @id @default(cuid()) assetId String version Int storageKey String @unique prompt String @db.Text createdAt DateTime @default(now()) asset GeneratedAsset @relation(fields:[assetId],references:[id],onDelete:Cascade) @@unique([assetId,version]) }
model ImageReference { id String @id @default(cuid()) tenantId String projectId String storageKey String @unique mimeType String byteSize BigInt sha256 String? createdAt DateTime @default(now()) tenant CreativeTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) project CreativeProject @relation(fields:[projectId],references:[id],onDelete:Cascade) jobs GenerationJob[] @@index([tenantId,projectId,createdAt]) }
model PromptTemplate { id String @id @default(cuid()) tenantId String projectId String? name String prompt String @db.Text variables Json? isShared Boolean @default(false) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt tenant CreativeTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) project CreativeProject? @relation(fields:[projectId],references:[id],onDelete:Cascade) @@unique([tenantId,name]) }
model AgentExecution { id String @id @default(cuid()) tenantId String projectId String jobId String? agentName String status CreativeAgentStatus @default(QUEUED) input Json? output Json? error String? @db.Text startedAt DateTime? completedAt DateTime? createdAt DateTime @default(now()) tenant CreativeTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) project CreativeProject @relation(fields:[projectId],references:[id],onDelete:Cascade) job GenerationJob? @relation(fields:[jobId],references:[id],onDelete:SetNull) @@index([tenantId,projectId,createdAt]) }
model GenerationUsage { id String @id @default(cuid()) tenantId String jobId String @unique provider CreativeProvider model String outputCount Int @default(1) outputBytes BigInt @default(0) estimatedCostUsd Decimal? @db.Decimal(12,6) providerRequestId String? createdAt DateTime @default(now()) tenant CreativeTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) job GenerationJob @relation(fields:[jobId],references:[id],onDelete:Cascade) @@index([tenantId,createdAt]) }
model AuditEvent { id String @id @default(cuid()) tenantId String actorKeyId String? action String entityType String entityId String metadata Json? createdAt DateTime @default(now()) tenant CreativeTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) @@index([tenantId,createdAt]) @@index([entityType,entityId]) }