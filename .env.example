# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/corleon?schema=public"

# Stripe — use sandbox/test keys only while STRIPE_LIVE_PAYMENTS_ENABLED=false.
STRIPE_SECRET_KEY="sk_test_replace_in_dashboard"
STRIPE_WEBHOOK_SECRET="whsec_replace_after_creating_test_webhook"
STRIPE_LIVE_PAYMENTS_ENABLED="false"

# Server-to-server billing API authentication. Generate at least 32 random bytes.
# NEVER expose this value to browser/mobile clients or use a NEXT_PUBLIC_ prefix.
CORLEON_BILLING_API_TOKEN="replace-with-64-hex-characters"

# Comma-separated HTTPS origins allowed for Checkout return and Billing Portal URLs.
CORLEON_BILLING_RETURN_ORIGINS="https://corleon-engine.vercel.app,https://your-standalone-app.example"

# Optional: sandbox Customer Portal configuration created for Corleon.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID="bpc_1UaFn3PqxJ12Pn9aNj6mPGsp"

# Required to enable the scheduled commission-release endpoint.
# Generate a strong random value and set it in Vercel; leave unset to keep releases disabled.
CRON_SECRET="replace-with-a-long-random-secret"
