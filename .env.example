# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/corleon?schema=public"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Required to enable the scheduled commission-release endpoint.
# Generate a strong random value and set it in Vercel; leave unset to keep releases disabled.
CRON_SECRET="replace-with-a-long-random-secret"

# Corleon Agent Runtime (server-side only)
CORLEON_AGENT_RUNTIME_ENABLED=false
CORLEON_AGENT_RUNTIME_PROVIDER=digitalocean
CORLEON_AGENT_RUNTIME_API_TOKEN=
DIGITALOCEAN_ACCESS_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# SEBI Regulatory Intelligence (server-side only)
# Generate a unique long random value. Required only for the protected ingestion endpoint.
SEBI_INGEST_SECRET=replace-with-a-long-random-secret
# Optional AI synthesis; retrieval-only source search works without this key.
CORLEON_SEBI_AI_MODEL=gpt-5-mini
SEBI_AI_ENABLED=false
