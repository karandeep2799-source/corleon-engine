# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/corleon?schema=public"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Required to enable the scheduled commission-release endpoint.
# Generate a strong random value and set it in Vercel; leave unset to keep releases disabled.
CRON_SECRET="replace-with-a-long-random-secret"


# Google Play Developer API (server-side only; do not commit real credentials)
GOOGLE_PLAY_PACKAGE_NAME=""
# Paste the service-account JSON as a single-line JSON string in the deployment secret manager.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
# Protects Corleon administrative API routes. Generate a high-entropy random secret.
GOOGLE_PLAY_ADMIN_TOKEN=""
# Optional Pub/Sub push OIDC verification. Configure the exact push audience and service-account email.
GOOGLE_PLAY_PUBSUB_AUDIENCE=""
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=""
# Publishing and support writes remain disabled unless explicitly enabled AND separately approved per request.
GOOGLE_PLAY_PUBLISHING_ENABLED="false"
GOOGLE_PLAY_SUPPORT_WRITES_ENABLED="false"
GOOGLE_PLAY_WRITE_APPROVAL_TOKEN=""
