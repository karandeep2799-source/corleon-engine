NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/corleon
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
# Add provider/OAuth secrets only through your secret manager or local .env.
BINANCE_MARKET_DATA_ENABLED=false
# Dedicated Binance Spot API key with USER_DATA permission only; never enable TRADE or withdrawals.
BINANCE_PRIVATE_API_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
# High-entropy bearer token for private Corleon API routes; server-only.
BINANCE_PORTFOLIO_ACCESS_TOKEN=
BINANCE_PAPER_TRADING_ENABLED=false
BINANCE_PAPER_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
BINANCE_PAPER_MAX_NOTIONAL_USDT=100
