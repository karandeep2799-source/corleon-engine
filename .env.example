NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/corleon
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
# TaskOS service principal adapter. Replace with Corleon session/JWT principal before multi-user production.
TASKOS_API_TOKEN=
TASKOS_TENANT_ID=default
TASKOS_USER_ID=system
# 32 random bytes as 64 hexadecimal characters. Rotate via encrypted-data migration.
TASKOS_ENCRYPTION_KEY=
TASKOS_STATE_SECRET=
# Google OAuth: Tasks readonly scope only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-tasks/callback
# Vercel Cron authenticates using this bearer secret.
CRON_SECRET=
# Stripe subscription billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOWED_PRICE_IDS=
STRIPE_ALLOWED_PAYMENT_PRICE_IDS=
# Existing Binance integration.
BINANCE_MARKET_DATA_ENABLED=false
BINANCE_PRIVATE_API_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_PORTFOLIO_ACCESS_TOKEN=
BINANCE_PAPER_TRADING_ENABLED=false
BINANCE_PAPER_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
BINANCE_PAPER_MAX_NOTIONAL_USDT=100
