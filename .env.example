# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/corleon?schema=public"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Required to enable the scheduled commission-release endpoint.
# Generate a strong random value and set it in Vercel; leave unset to keep releases disabled.
CRON_SECRET="replace-with-a-long-random-secret"

# Angel One SmartAPI — read-only portfolio monitoring (disabled by default).
ANGELONE_PRIVATE_API_ENABLED="false"
ANGELONE_API_KEY=""
ANGELONE_JWT_TOKEN=""
ANGELONE_CLIENT_LOCAL_IP=""
ANGELONE_CLIENT_PUBLIC_IP=""
ANGELONE_MAC_ADDRESS=""
ANGELONE_SOURCE_ID="WEB"
# Generate a long random token; used by the private Corleon portfolio API and dashboard.
ANGELONE_PORTFOLIO_ACCESS_TOKEN=""

# Atlassian Organization Admin API — read-only gateway (disabled by default).
ATLASSIAN_ADMIN_API_ENABLED="false"
ATLASSIAN_ADMIN_API_KEY=""
ATLASSIAN_ORG_ID=""
# Independent token protecting Corleon Engine's internal Atlassian route.
CORLEON_ATLASSIAN_ROUTE_TOKEN=""
