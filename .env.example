# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/corleon?schema=public"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Required to enable the scheduled commission-release endpoint.
# Generate a strong random value and set it in Vercel; leave unset to keep releases disabled.
CRON_SECRET="replace-with-a-long-random-secret"

# WEEGLOO remote MCP integration (disabled by default)
WEEGLOO_ENABLED="false"
WEEGLOO_MCP_URL="https://ai.weegloo.com/mcp"
# Comma-separated exact tool names reviewed and approved for read-only calls.
WEEGLOO_READ_ONLY_TOOLS=""
# High-entropy server-to-server key protecting /api/integrations/weegloo.
CORLEON_INTEGRATION_API_KEY=""
