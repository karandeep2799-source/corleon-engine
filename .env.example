# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/corleon?schema=public"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Required to enable the scheduled commission-release endpoint.
# Generate a strong random value and set it in Vercel; leave unset to keep releases disabled.
CRON_SECRET="replace-with-a-long-random-secret"

# TinyFish (server-side only; never use NEXT_PUBLIC_ prefixes)
TINYFISH_API_KEY="sk-tinyfish-..."
CORLEON_TINYFISH_ACCESS_TOKEN="replace-with-a-long-random-secret"
