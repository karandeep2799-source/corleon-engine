{
  "name": "@corleon/earnings-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tenant-scoped earnings transcript ingestion and analysis domain module for Corleon Engine.",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "^6.16.0",
    "typescript": "^5.9.2",
    "@types/node": "^22.18.6"
  }
}
