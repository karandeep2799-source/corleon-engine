{
  "name": "corleon-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "dev": "next dev",
    "build": "prisma generate && npm run eve:build && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "eve:dev": "eve dev",
    "eve:build": "eve build",
    "eve:info": "eve info"
  },
  "dependencies": {
    "@openai/agents": "^0.17.0",
    "@prisma/client": "^6.16.0",
    "openai": "^7.9.0",
    "stripe": "^18.5.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@vercel/connect": "2.5.5",
    "eve": "^0.83.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "^6.16.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "vitest": "^3.2.0"
  }
}
