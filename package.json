{
  "name": "corleon-engine",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo build --filter=@corleon/web",
    "build:agent": "eve build",
    "dev": "turbo run dev",
    "dev:agent": "eve dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typecheck:agent": "tsc -p agent/tsconfig.json",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@vercel/connect": "2.5.5",
    "eve": "^0.83.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "~24.19.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "7.0.2"
  }
}
