{
  "executablePath": "/usr/bin/chromium",
  "headless": true,
  "isolated": true,
  "pageIdRouting": true,
  "proxyServer": "http://egress-proxy:3128",
  "categoryInput": false,
  "categoryNavigation": true,
  "categoryEmulation": false,
  "categoryPerformance": true,
  "categoryNetwork": true,
  "categoryDebugging": true,
  "categoryExtensions": false,
  "categoryExperimentalThirdParty": false,
  "categoryMemory": false,
  "categoryExperimentalWebmcp": false,
  "categoryPwa": false,
  "categoryWebauthn": false,
  "experimentalDevtools": false,
  "experimentalVision": false,
  "memoryDebugging": false,
  "experimentalStructuredContent": false,
  "fileNavigations": false,
  "redactNetworkHeaders": true,
  "acceptInsecureCerts": false,
  "maxNavigationSaved": 2,
  "blockedUrlPattern": [
    "*://localhost:*/*",
    "*://127.0.0.1:*/*",
    "*://[::1]:*/*",
    "*://169.254.169.254:*/*",
    "*://169.254.170.2:*/*",
    "*://metadata.google.internal:*/*"
  ]
}
