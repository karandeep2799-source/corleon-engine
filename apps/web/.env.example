# Required
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/corleon?sslmode=require"
SESSION_SECRET="replace-with-at-least-32-random-characters"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Trading safety: keep false until broker adapter certification, compliance review,
# market permissions, and operational runbooks are complete.
LIVE_TRADING_ENABLED="false"

# Market-data providers (add provider-specific secrets via Vercel Environment Variables)
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
COINBASE_ADVANCED_API_KEY=""
COINBASE_ADVANCED_API_SECRET=""
ZERODHA_API_KEY=""
ZERODHA_API_SECRET=""
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
IBKR_GATEWAY_URL=""

# Never store broker secrets in plaintext database fields. Use a managed secret vault
# and store only secret references in BrokerConnection.secretRef.


# World Bank Data Catalog (public API; no API key required)
WORLD_BANK_API_BASE_URL="https://ddh-openapi.worldbank.org"
# Protects POST /api/global-data/sync; use a random value of at least 32 characters.
CRON_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
