generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String             @id @default(cuid())
  email       String             @unique
  name        String?
  image       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  accounts    TradingAccount[]
  brokers     BrokerConnection[]
  orders      Order[]
  positions   Position[]
  riskLimits  RiskLimit[]
  auditEvents AuditEvent[]
  currencyStores CurrencyStore[]
  currencyWallets CurrencyWallet[]

  @@index([createdAt])
}

model TradingAccount {
  id           String             @id @default(cuid())
  userId       String
  name         String
  baseCurrency String             @default("USD")
  status       String             @default("ACTIVE")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]
  positions    Position[]

  @@index([userId, status])
}

model BrokerConnection {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  market         String
  externalUserId String?
  status         String   @default("PENDING")
  scopes         String[] @default([])
  secretRef      String?
  connectedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, market])
  @@index([status, market])
}

model Order {
  id                String   @id @default(cuid())
  userId            String
  accountId         String
  brokerConnectionId String?
  provider          String
  market            String
  symbol            String
  side              String
  orderType         String
  timeInForce       String   @default("DAY")
  quantity          Decimal  @db.Decimal(28, 10)
  limitPrice        Decimal? @db.Decimal(28, 10)
  stopPrice         Decimal? @db.Decimal(28, 10)
  status            String   @default("PENDING")
  externalOrderId   String?
  idempotencyKey    String
  rejectionReason   String?
  submittedAt       DateTime?
  filledAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([accountId, status])
  @@index([provider, externalOrderId])
}

model Position {
  id             String   @id @default(cuid())
  userId         String
  accountId      String
  market         String
  symbol         String
  quantity       Decimal  @db.Decimal(28, 10)
  averagePrice   Decimal  @db.Decimal(28, 10)
  currency       String
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, market, symbol])
  @@index([userId, market])
}

model RiskLimit {
  id                   String   @id @default(cuid())
  userId               String
  market               String
  maxOrderNotional     Decimal? @db.Decimal(28, 10)
  maxDailyNotional     Decimal? @db.Decimal(28, 10)
  maxOpenOrders        Int      @default(10)
  tradingEnabled       Boolean  @default(false)
  requireLimitOrders   Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, market])
}

model AuditEvent {
  id          String   @id @default(cuid())
  userId      String?
  actorType   String
  action      String
  resource    String
  resourceId  String?
  outcome     String
  metadata    Json?
  ipHash      String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  userId      String
  key         String
  requestHash String
  response    Json?
  status      String   @default("IN_PROGRESS")
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([userId, key])
  @@index([expiresAt])
}


model WorldBankDataset {
  id           String   @id @default(cuid())
  uniqueId     String   @unique
  title        String
  description  String?
  version      String?
  sourceUrl    String?
  metadata     Json
  syncedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  versions     WorldBankDatasetVersion[]
  resources    WorldBankResource[]
  indicators   WorldBankIndicator[]
  citations    WorldBankCitation[]

  @@index([title])
  @@index([syncedAt])
}

model WorldBankDatasetVersion {
  id              String   @id @default(cuid())
  datasetId       String
  sourceVersionId String
  metadata        Json
  capturedAt      DateTime @default(now())
  dataset         WorldBankDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, sourceVersionId])
  @@index([datasetId, capturedAt])
}

model WorldBankResource {
  id          String   @id @default(cuid())
  uniqueId    String   @unique
  datasetId   String
  title       String
  description String?
  fileFormat  String?
  downloadUrl String?
  metadata    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dataset     WorldBankDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
}

model WorldBankIndicator {
  id          String   @id @default(cuid())
  uniqueId    String   @unique
  datasetId   String
  name        String
  description String?
  metadata    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dataset     WorldBankDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([name])
}

model WorldBankCitation {
  id        String   @id @default(cuid())
  uniqueId  String   @unique
  datasetId String
  title     String
  url       String?
  year      String?
  metadata  Json
  createdAt DateTime @default(now())
  dataset   WorldBankDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
}

model WorldBankSyncJob {
  id              String   @id @default(cuid())
  status          String   @default("PENDING")
  recordsSeen     Int      @default(0)
  recordsUpserted Int      @default(0)
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  logs            WorldBankSyncLog[]

  @@index([status, createdAt])
}

model WorldBankSyncLog {
  id        String   @id @default(cuid())
  jobId     String
  level     String   @default("INFO")
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  job       WorldBankSyncJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}


// Closed-loop Corleon credits. These are loyalty/usage credits, not money,
// deposits, stored monetary value, or a transferable token.
enum CurrencyWalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CurrencyLedgerType {
  ISSUE
  REDEEM
  REVERSAL
  EXPIRY
  ADJUSTMENT
}

model CurrencyStore {
  id          String   @id @default(cuid())
  ownerUserId String
  name        String
  slug        String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  entries     CurrencyLedgerEntry[]

  @@unique([ownerUserId, slug])
  @@index([ownerUserId, status])
}

model CurrencyWallet {
  id             String               @id @default(cuid())
  ownerUserId    String
  customerEmail  String
  customerName   String?
  status         CurrencyWalletStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  owner          User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  entries        CurrencyLedgerEntry[]

  @@unique([ownerUserId, customerEmail])
  @@index([ownerUserId, status])
}

model CurrencyLedgerEntry {
  id             String            @id @default(cuid())
  ownerUserId    String
  walletId       String
  storeId        String?
  type           CurrencyLedgerType
  amount         Int
  reason         String
  orderReference String?
  idempotencyKey String            @unique
  metadata       Json?
  createdAt      DateTime          @default(now())
  wallet         CurrencyWallet    @relation(fields: [walletId], references: [id], onDelete: Restrict)
  store          CurrencyStore?    @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, createdAt])
  @@index([walletId, createdAt])
  @@index([storeId, createdAt])
  @@index([type, createdAt])
}
